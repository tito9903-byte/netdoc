APP_NAME=NetDoc
APP_VERSION=0.9.0

NETBOX_URL=https://192.168.10.95
NETBOX_TOKEN=REEMPLAZAR_CON_TOKEN
NETBOX_TOKEN_TYPE=token
NETBOX_VERIFY_SSL=false
NETBOX_TIMEOUT=15
NETBOX_WRITE_ENABLED=false

SESSION_SECRET=GENERAR_UN_VALOR_SEGURO
SESSION_COOKIE_NAME=netdoc_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=28800

# Credenciales usadas para crear el primer administrador si la base está vacía.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERAR_CON_CONFIGURE_ADMIN

# Cada entorno debe usar su propia base de datos.
DATABASE_URL=sqlite:///./data/netdoc.db
AUDIT_PAGE_SIZE=50
