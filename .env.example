APP_NAME=NetDoc
APP_VERSION=0.11.0

NETBOX_URL=https://192.168.10.95
NETBOX_TOKEN=REEMPLAZAR_CON_TOKEN
NETBOX_TOKEN_TYPE=token
NETBOX_VERIFY_SSL=false
NETBOX_TIMEOUT=15
NETBOX_WRITE_ENABLED=false

# Descubrimiento LLDP por SSH. Las credenciales nunca se guardan en NetBox.
NETDOC_SSH_DISCOVERY_ENABLED=false
NETDOC_SSH_CONNECT_TIMEOUT=10
NETDOC_SSH_COMMAND_TIMEOUT=30
NETDOC_SSH_MAX_NEIGHBORS=256

# El perfil default se hereda. Cada plataforma puede reemplazar usuario,
# contraseña, llave, puerto, device_type de Netmiko o comando LLDP.
# use_enable=true hace que NetDoc ejecute enable antes del comando LLDP.
# En ese caso secret es obligatorio y puede ser distinto de password.
# Perfiles soportados inicialmente: arista_eos, cisco_ios, cisco_nxos,
# juniper_junos y mikrotik_routeros.
NETDOC_SSH_PROFILES_JSON='{"default":{"username":"netdoc-read","password":"REEMPLAZAR","port":22,"use_enable":false},"arista_eos":{"use_enable":true,"secret":"REEMPLAZAR_ENABLE"},"cisco_ios":{},"cisco_nxos":{},"juniper_junos":{},"mikrotik_routeros":{}}'

# Para autenticación por llave sustituye password por, por ejemplo:
# "private_key_file":"/etc/netdoc/ssh/netdoc_read"

SESSION_SECRET=GENERAR_UN_VALOR_SEGURO
SESSION_COOKIE_NAME=netdoc_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=28800

# Protección básica contra intentos repetidos desde la misma IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Credenciales usadas para crear el primer administrador si la base está vacía.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERAR_CON_CONFIGURE_ADMIN

# Cada entorno debe usar su propia base de datos.
DATABASE_URL=sqlite:///./data/netdoc.db
AUDIT_PAGE_SIZE=50
