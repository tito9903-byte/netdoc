#!/usr/bin/env bash
# Actualiza exclusivamente el entorno de desarrollo de NetDoc.
set -euo pipefail

APP_DIR="/opt/netdoc-dev"
BRANCH="develop"
SERVICE="netdoc-dev"
HEALTH_URL="http://127.0.0.1:8101/login"
VENV_DIR="$APP_DIR/.venv"
REQUIREMENTS_FILE="requirements-lock.txt"
PREVIOUS_COMMIT=""
NEW_COMMIT=""
HTTP_STATUS="no comprobado"
DEPLOYMENT_STARTED=false

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

check_health() {
  HTTP_STATUS=$(curl --silent --show-error --output /dev/null \
    --write-out '%{http_code}' --max-time 10 "$HEALTH_URL")
  if [[ ! $HTTP_STATUS =~ ^(200|30[0-9])$ ]]; then
    echo "ERROR: /login devolvió HTTP $HTTP_STATUS." >&2
    return 1
  fi
}

rollback() {
  local status=$?
  trap - ERR
  set +e

  if [[ $DEPLOYMENT_STARTED != true ]]; then
    exit "$status"
  fi

  echo "ERROR: despliegue falló; se restaura el commit $PREVIOUS_COMMIT." >&2
  git reset --hard "$PREVIOUS_COMMIT"
  local reset_status=$?
  "$VENV_DIR/bin/pip" install --requirement "$REQUIREMENTS_FILE"
  local dependencies_status=$?
  systemctl restart "$SERVICE"
  local restart_status=$?
  sleep 2
  systemctl is-active --quiet "$SERVICE"
  local service_status=$?
  HTTP_STATUS=$(curl --silent --show-error --output /dev/null \
    --write-out '%{http_code}' --max-time 10 "$HEALTH_URL")
  local health_status=$?

  echo "Rollback: rama=$BRANCH, commit=$PREVIOUS_COMMIT, HTTP=$HTTP_STATUS" >&2
  if (( reset_status || dependencies_status || restart_status || service_status || health_status )) \
    || [[ ! $HTTP_STATUS =~ ^(200|30[0-9])$ ]]; then
    echo "ERROR: el rollback requiere revisión manual." >&2
  fi
  exit "$status"
}

[[ ${EUID} -eq 0 ]] || fail "este comando debe ejecutarse como root."
[[ -d $APP_DIR && -d $APP_DIR/.git ]] || fail "$APP_DIR no es un repositorio Git."
[[ -f $APP_DIR/.env ]] || fail "falta $APP_DIR/.env (no se mostrará ni modificará)."
[[ -x $VENV_DIR/bin/python ]] || fail "falta el entorno virtual en $VENV_DIR."
[[ -f $APP_DIR/$REQUIREMENTS_FILE ]] || fail "falta $APP_DIR/$REQUIREMENTS_FILE."
systemctl cat "$SERVICE" >/dev/null 2>&1 || fail "el servicio $SERVICE no existe."

cd "$APP_DIR"
[[ $(git branch --show-current) == "$BRANCH" ]] || fail "la rama local debe ser $BRANCH."
git remote get-url origin >/dev/null 2>&1 || fail "falta el remoto origin."
git diff --quiet || fail "hay cambios sin confirmar; el despliegue se cancela."
git diff --cached --quiet || fail "hay cambios preparados; el despliegue se cancela."

PREVIOUS_COMMIT=$(git rev-parse HEAD)
trap rollback ERR
echo "NetDoc desarrollo: rama=$BRANCH, commit anterior=$PREVIOUS_COMMIT"
git fetch --prune origin
git show-ref --verify --quiet "refs/remotes/origin/$BRANCH" \
  || fail "origin/$BRANCH no existe."
DEPLOYMENT_STARTED=true
git reset --hard "origin/$BRANCH"
NEW_COMMIT=$(git rev-parse HEAD)
"$VENV_DIR/bin/pip" install --requirement "$REQUIREMENTS_FILE"
"$VENV_DIR/bin/python" -m compileall app
"$VENV_DIR/bin/python" -c 'from app.main import app; print(app.title)'
systemctl restart "$SERVICE"
sleep 2
systemctl is-active --quiet "$SERVICE"
check_health
trap - ERR
echo "Despliegue completado: rama=$BRANCH, anterior=$PREVIOUS_COMMIT, nuevo=$NEW_COMMIT, HTTP=$HTTP_STATUS"
